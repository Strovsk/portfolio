generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TechSkill {
  id                String   @id @default(cuid())
  name              String   @unique
  link              String
  primary_color     String
  secondary_color   String
  short_description String
  start_date        DateTime
  end_date          DateTime
}
